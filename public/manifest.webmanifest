{
  "name": "AppWatch – uptime monitor",
  "short_name": "AppWatch",
  "description": "Watch your apps and servers, get alerted when they go down.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0d12",
  "theme_color": "#0f131a",
  "categories": ["utilities", "developer", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Incidents", "url": "/#/incidents", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add monitor", "url": "/#/monitors/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
